{
  "name": "Client",
  "type": "object",
  "properties": {
    "client_name": {
      "type": "string",
      "description": "Client/franchise group name"
    },
    "description": {
      "type": "string",
      "description": "Description of the client"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "client_name"
  ],
  "rls": {
    "create": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "user" } }
      ]
    },
    "read": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "user" } }
      ]
    },
    "update": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "user" } }
      ]
    },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
