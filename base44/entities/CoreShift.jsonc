{
  "name": "CoreShift",
  "properties": {
    "employee_email": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "lunch_end": {
      "description": "Fixed lunch end, HH:mm (e.g. 13:00)",
      "type": "string"
    },
    "lunch_start": {
      "description": "Fixed lunch start, HH:mm (e.g. 12:00)",
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "shift_date": {
      "format": "date",
      "type": "string"
    },
    "shift_name": {
      "type": "string"
    },
    "start_time": {
      "type": "string"
    },
    "status": {
      "default": "scheduled",
      "enum": [
        "scheduled",
        "completed",
        "cancelled"
      ],
      "type": "string"
    }
  },
  "required": [
    "employee_email",
    "shift_date"
  ],
  "type": "object"
}