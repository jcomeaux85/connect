{
  "name": "TrainingModule",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Module title shown in the curriculum list"
    },
    "module_type": {
      "type": "string",
      "enum": [
        "audio_gated",
        "specified_training"
      ],
      "default": "audio_gated",
      "description": "audio_gated = audio + text with quiz after; specified_training = assigned training with deadline"
    },
    "module_number": {
      "type": "number",
      "description": "Order in the curriculum (1-based)"
    },
    "audio_url": {
      "type": "string",
      "description": "URL to audio content (audio_gated modules)"
    },
    "text_content": {
      "type": "string",
      "description": "Lesson text content (HTML or markdown)"
    },
    "header_image_url": {
      "type": "string",
      "description": "Module header image URL"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Topic tags for OMMNI matching"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "question_num": {
            "type": "number"
          },
          "prompt": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "correct_answer": {
            "type": "string"
          }
        }
      },
      "description": "Quiz questions shown AFTER the audio completes (not during)"
    },
    "deadline": {
      "type": "string",
      "format": "date",
      "description": "Deadline for completing this module (YYYY-MM-DD)"
    },
    "assigned_to": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails of users assigned to this training (specified_trainings only)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "title",
    "module_type"
  ]
}