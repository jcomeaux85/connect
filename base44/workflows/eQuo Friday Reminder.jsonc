{
  "name": "eQuo Friday Reminder",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * 5",
      "one_time_date": null,
      "timezone": "America/Chicago",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "equo_friday_reminder",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "friday_nudge": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "equo-friday-reminder"
          },
          "then": "end",
          "x-base44": {
            "title": "Friday reminder + auto-publish",
            "description": "Nudges incomplete employees"
          }
        }
      }
    ]
  },
  "description": "Every Friday at 9am: auto-publishes scheduled questions and nudges employees who haven't completed their weekly check-in"
}