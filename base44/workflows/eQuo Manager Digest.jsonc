{
  "name": "eQuo Manager Digest",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 16 * * 5",
      "one_time_date": null,
      "timezone": "America/Chicago",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "equo_manager_digest",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_digest": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "equo-manager-digest"
          },
          "then": "end",
          "x-base44": {
            "title": "Manager digest email",
            "description": "Weekly team summary to admins"
          }
        }
      }
    ]
  },
  "description": "Every Friday at 4pm: emails each admin a weekly digest of their team's status, flags, and mood"
}