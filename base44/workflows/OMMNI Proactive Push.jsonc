{
  "description": "Runs OMMNI anomaly detection + predictive forecasting every weekday morning and proactively pushes high-severity insights to the right people before anyone asks",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "ommni_proactive_push",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "push": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "ommni-engine",
            "args": {
              "action": "push"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Push OMMNI insights",
            "description": "Run anomalies + forecast, notify the right people"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * 1-5",
      "one_time_date": null,
      "timezone": "America/Chicago",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "OMMNI Proactive Push"
}